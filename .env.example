# Copy this file to  .env.local  and fill it in.

# MongoDB: a local server, or an Atlas connection string (mongodb+srv://user:password@cluster.xxxx.mongodb.net)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ferentino

# The administrator account is created on the very first start (also the address people write to for a password reset)
ADMIN_EMAIL=admin@yourcompany.lk
ADMIN_NAME=System Administrator
# Optional. If empty, a temporary password is printed in the terminal on the first start.
ADMIN_PASSWORD=

SESSION_HOURS=10
# Set both to 1 once the site is served over https behind a reverse proxy
COOKIE_SECURE=0
TRUST_PROXY=0

# One page's records are one MongoDB document, so this cannot be more than 16
MAX_DATA_MB=15
MAX_FILE_MB=200

# Resend (resend.com): lets the system send real e-mails, e.g. notifying an Internal Audit Team Leader.
# Leave both empty to disable e-mail sending — affected features will show a clear "not configured" message instead of failing silently.
RESEND_API_KEY=
MAIL_FROM=Ferentino Internal Audit <audit@yourcompany.lk>

